<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Product_Required</fullName>
    <active>true</active>
    <description>Product2 cannot be the target of a required lookup, so the rule enforces it.</description>
    <errorConditionFormula>ISBLANK(Product__c)</errorConditionFormula>
    <errorDisplayField>Product__c</errorDisplayField>
    <errorMessage>Select a product.</errorMessage>
</ValidationRule>
