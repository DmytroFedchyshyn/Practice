{
  "name": "agentforce-distributor",
  "private": true,
  "description": "Code checks and unit tests for Agentforce Distributor: formatting, linting, static analysis, secret scanning and Jest for the Lightning web components, locally and in the pipeline. See docs/engineering/development-foundation.md and docs/engineering/ci-cd.md.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write \"force-app/distributor/**/*.{cls,trigger,js,html,css}\"",
    "format:check": "prettier --check \"force-app/distributor/**/*.{cls,trigger,js,html,css}\"",
    "lint": "eslint \"force-app/distributor/**/{aura,lwc}/**/*.js\" --no-warn-ignored --no-error-on-unmatched-pattern",
    "scan": "mkdir -p reports && sf code-analyzer run --workspace force-app/distributor --rule-selector Recommended --rule-selector pmd:Security --output-file reports/code-analyzer.html",
    "scan:org": "mkdir -p reports && sf code-analyzer run --workspace force-app/main/default --rule-selector Recommended --rule-selector pmd:Security --output-file reports/code-analyzer-org.html",
    "secrets": "gitleaks git --redact --no-banner --verbose",
    "test": "sfdx-lwc-jest -- --passWithNoTests",
    "test:coverage": "sfdx-lwc-jest --coverage",
    "test:ci": "sfdx-lwc-jest -- --ci --passWithNoTests --reporters=default --reporters=jest-junit",
    "prepare": "git config core.hooksPath .githooks && chmod +x .githooks/* || true"
  },
  "lint-staged": {
    "force-app/distributor/**/*.{cls,trigger,js,html,css}": "prettier --write",
    "force-app/distributor/**/{aura,lwc}/**/*.js": "eslint --no-warn-ignored",
    "force-app/distributor/**/lwc/**": "sfdx-lwc-jest -- --bail --findRelatedTests --passWithNoTests"
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "jest.xml",
    "suiteNameTemplate": "{filepath}",
    "reportTestSuiteErrors": "true"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@lwc/eslint-plugin-lwc": "3.5.0",
    "@salesforce/eslint-config-lwc": "4.1.2",
    "@salesforce/eslint-plugin-aura": "3.0.0",
    "@salesforce/eslint-plugin-lightning": "2.0.0",
    "@salesforce/sfdx-lwc-jest": "7.9.0",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "28.14.0",
    "globals": "15.14.0",
    "jest-junit": "17.0.0",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "prettier-plugin-apex": "2.3.0"
  }
}
