#!/bin/sh
# Pre-push check (docs/engineering/development-foundation.md §1.4). Installed by `npm install`,
# which points git at .githooks.
#
# Metadata reaches the default branch only through a merge request: a push to that branch is stopped
# when one of the commits it brings changes a protected path (project.config.json: defaultBranch,
# protectedPaths; by default force-app/). Documentation and tooling may still go straight to it.
# The pipeline on the default branch checks the same rule after the fact (job force-app-via-mr).
#
# `git push --no-verify` skips this hook; the pipeline on the default branch still reports the push.

config=project.config.json
branch=main
paths=force-app/
if command -v jq >/dev/null 2>&1 && [ -f "$config" ]; then
    branch=$(jq -r '.defaultBranch // "main"' "$config")
    paths=$(jq -r '(.protectedPaths // ["force-app/"]) | join(" ")' "$config")
fi

zero=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "refs/heads/$branch" ] || continue
    [ "$local_sha" = "$zero" ] && continue

    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes"
    elif git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        range="$remote_sha..$local_sha"
    else
        echo "pre-push: $branch on the remote has commits this copy has not seen. Run 'git fetch' first." >&2
        exit 1
    fi

    # shellcheck disable=SC2086
    commits=$(git rev-list $range -- $paths)
    if [ -n "$commits" ]; then
        echo "pre-push: this push to $branch changes $paths, which goes through a merge request (docs/engineering/development-foundation.md §1.4):" >&2
        for c in $commits; do
            echo "  $(git log -1 --format='%h %s' "$c")" >&2
            # shellcheck disable=SC2086
            git diff-tree --no-commit-id --name-only -r "$c" -- $paths | sed -n '1,5s/^/      /p' >&2
        done
        echo "Push a branch and open a merge request instead." >&2
        status=1
    fi
done

exit $status
