# Values this project was created with from the Salesforce delivery kit (init.sh). No secrets.
# To take a later kit version: run its init.sh with this file into an empty folder and diff.

PROJECT_NAME=Agentforce Distributor
PROJECT_SLUG=agentforce-distributor
PROJECT_DIR=projects/agentforce-distributor

CI_PLATFORM=github
REPO_HOST_URL=https://github.com
REPO_PATH=DmytroFedchyshyn/Practice
DEFAULT_BRANCH=master

TRACKER_KIND=github
TRACKER_BOARD_ID=none
TRACKER_ISSUE_TYPE=task

BUILD_DIR=force-app/distributor
SNAPSHOT_DIR=force-app/main/default
METADATA_PREFIX=DST_
APEX_PREFIX=Dst
LWC_PREFIX=dst
SOURCE_API_VERSION=68.0
LWC_RUNTIME=Lightning Experience, and an Experience Cloud site whose template is chosen in phase 4

CI_ORG_ALIAS=agentforce-ci
BUILD_ORG_ALIAS_PATTERN=agentforce-dev
REVIEW_MARKER=dst-review
COVERAGE_CLASS=85
COVERAGE_ORG=75
NODE_VERSION=22
SF_CLI_VERSION=2.159.7
CODE_ANALYZER_VERSION=5.16.0
GITLEAKS_VERSION=8.30.1
